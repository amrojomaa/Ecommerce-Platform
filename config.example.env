APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastapi
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=180
STRIPE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
AUTO_CREATE_TABLES=false
ALLOW_DEV_VERIFICATION_CODE=false
AUTH_RATE_LIMIT_COUNT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
